# Public website origin, e.g. https://your-portfolio.example.
# Required behind an HTTPS-terminating reverse proxy; no trailing slash.
PUBLIC_ORIGIN=
# Leave at zero unless traffic can ONLY reach this server through trusted proxies.
# Set to the exact number of trusted proxy hops to use X-Forwarded-For for IP limits.
TRUST_PROXY_HOPS=0

# Optional Pushover alerts. Server-side only: never prefix these with VITE_.
# First chat message sends an alert; subsequent alerts are suppressed for 30 minutes.
# Register an application at https://pushover.net/apps/build for its API token.
PUSHOVER_API_TOKEN=
PUSHOVER_USER_KEY=
# Persist this file across container restarts to retain the cooldown.
PUSHOVER_STATE_PATH=./data/pushover-state.json

# Optional AI studio host. Server-side only: never prefix these with VITE_.
OPENAI_API_KEY=
# A Responses API model supporting Structured Outputs.
OPENAI_MODEL=gpt-4.1-mini
